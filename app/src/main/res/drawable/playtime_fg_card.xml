<?xml version="1.0" encoding="utf-8"?>
<!-- Contorno azul ao focar/passar por cima de um cartao (foreground), com ripple ao tocar -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#22FFFFFF">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <stroke android:width="2dp" android:color="@color/orbita_accent" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:state_hovered="true">
                <shape android:shape="rectangle">
                    <stroke android:width="2dp" android:color="@color/orbita_accent" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item>
                <color android:color="@android:color/transparent" />
            </item>
        </selector>
    </item>
</ripple>
