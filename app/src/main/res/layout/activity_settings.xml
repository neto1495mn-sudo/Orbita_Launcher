<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_settings_panel"
    android:padding="0dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="12dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/set_title"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#4A4B50" />

    <!-- 4-Column Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="4dp"
        android:paddingHorizontal="12dp"
        android:weightSum="4">

        <!-- ============================================ -->
        <!-- COLUMN 1: LAUNCHER & APPEARANCE -->
        <!-- ============================================ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingEnd="12dp"
            android:orientation="vertical"
            android:clipToPadding="true">

            <!-- LAUNCHER section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_section_launcher"
                android:textColor="#6B8EFF"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.15"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_launcher_subtitle"
                android:textColor="#666666"
                android:textSize="9sp"
                android:layout_marginTop="2dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#4A4B50"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp" />

            <!-- Edit Mode -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/set_edit_mode"
                    android:textColor="#E0E0E0"
                    android:textSize="11sp"
                    android:paddingEnd="4dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchEditMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleX="0.85"
                    android:scaleY="0.85" />
            </LinearLayout>

            <!-- Show Categories -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/set_show_categories"
                    android:textColor="#E0E0E0"
                    android:textSize="11sp"
                    android:paddingEnd="4dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchCategories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleX="0.85"
                    android:scaleY="0.85" />
            </LinearLayout>

            <!-- Manage Categories -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_categories"
                android:textColor="#E0E0E0"
                android:textSize="11sp"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/btnManageCategories"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginBottom="6dp"
                android:backgroundTint="#673AB7"
                android:text="@string/set_manage_categories"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:minHeight="0dp"
                android:padding="0dp" />

            <!-- Hover Trigger (accessibility-based shortcut) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_focus_trigger"
                android:textColor="#E0E0E0"
                android:textSize="11sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/lblHoverTriggerStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_focus_trigger_hint"
                android:textColor="#888888"
                android:textSize="10sp"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btnHoverTrigger"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginBottom="8dp"
                android:backgroundTint="#00897B"
                android:text="@string/set_enable_trigger"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:minHeight="0dp"
                android:padding="0dp" />

            <!-- APPEARANCE section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_section_appearance"
                android:textColor="#6B8EFF"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.15"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_sizes_opacity"
                android:textColor="#666666"
                android:textSize="9sp"
                android:layout_marginTop="2dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#4A4B50"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp" />

            <!-- Icon Size -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_icon_size"
                android:textColor="#E0E0E0"
                android:textSize="11sp"
                android:layout_marginBottom="2dp" />

            <!-- Icon Size Range Display -->
            <TextView
                android:id="@+id/txtIconSizeRange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_icon_size_range"
                android:textColor="#666666"
                android:textSize="9sp"
                android:layout_marginBottom="4dp" />

            <SeekBar
                android:id="@+id/seekIconSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="50" />

            <TextView
                android:id="@+id/txtIconSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:gravity="end"
                android:text="125dp"
                android:textColor="#888888"
                android:textSize="10sp" />

            <!-- Background Opacity -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_bg_opacity"
                android:textColor="#E0E0E0"
                android:textSize="11sp"
                android:layout_marginBottom="4dp" />

            <SeekBar
                android:id="@+id/seekBgOpacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="100" />

            <TextView
                android:id="@+id/txtBgOpacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="100%"
                android:textColor="#888888"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- Column Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#4A4B50" />

        <!-- ============================================ -->
        <!-- COLUMN 2: STARTUP & SYSTEM -->
        <!-- ============================================ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingHorizontal="12dp"
            android:orientation="vertical"
            android:clipToPadding="true">

            <!-- STARTUP section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_section_startup"
                android:textColor="#6B8EFF"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.15"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_autostart_options"
                android:textColor="#666666"
                android:textSize="9sp"
                android:layout_marginTop="2dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#4A4B50"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp" />

            <!-- Auto-start on Boot -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/set_start_with_system"
                    android:textColor="#E0E0E0"
                    android:textSize="11sp"
                    android:paddingEnd="4dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchAutoStart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleX="0.85"
                    android:scaleY="0.85" />
            </LinearLayout>

            <TextView
                android:id="@+id/autoRestartStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_status_off"
                android:textColor="#666666"
                android:textSize="10sp"
                android:layout_marginBottom="8dp" />

            <!-- Reabrir ao fechar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/set_reopen_on_close"
                    android:textColor="#E0E0E0"
                    android:textSize="11sp"
                    android:paddingEnd="4dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchReopenOnClose"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleX="0.85"
                    android:scaleY="0.85" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_reopen_desc"
                android:textColor="#9A9BA0"
                android:textSize="10sp"
                android:layout_marginBottom="8dp" />

            <!-- Suppress Meta Store -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/set_hide_meta_store"
                    android:textColor="#E0E0E0"
                    android:textSize="11sp"
                    android:paddingEnd="4dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchSuppressStore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleX="0.85"
                    android:scaleY="0.85" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_hide_meta_store_desc"
                android:textColor="#666666"
                android:textSize="9sp"
                android:layout_marginBottom="8dp" />

            <!-- SYSTEM section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_section_system"
                android:textColor="#6B8EFF"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.15"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_quest_system_controls"
                android:textColor="#666666"
                android:textSize="9sp"
                android:layout_marginTop="2dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#4A4B50"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp" />

            <!-- Native Settings - opens Quest's Android Settings directly (no APK needed) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_native_settings"
                android:textColor="#E0E0E0"
                android:textSize="11sp"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/btnNativeSettings"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginBottom="6dp"
                android:backgroundTint="#4CAF50"
                android:text="@string/set_open"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:minHeight="0dp"
                android:padding="0dp" />

            <!-- Device Info -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_device_info"
                android:textColor="#E0E0E0"
                android:textSize="11sp"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/btnDeviceInfo"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginBottom="6dp"
                android:backgroundTint="#607D8B"
                android:text="@string/set_view"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:minHeight="0dp"
                android:padding="0dp" />

            <!-- Endereco IP -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_ip_address"
                android:textColor="#E0E0E0"
                android:textSize="11sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/txtSettingsIP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:fontFamily="sans-serif-medium"
                android:tag="theme_ignore"
                android:text="@string/set_ip_placeholder"
                android:textColor="#32CD32"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Column Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#4A4B50" />

        <!-- ============================================ -->
        <!-- COLUMN 3: UPDATES & DATA -->
        <!-- ============================================ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingHorizontal="12dp"
            android:orientation="vertical"
            android:clipToPadding="true">

            <!-- UPDATES section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_section_updates"
                android:textColor="#6B8EFF"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.15"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_check_new_versions"
                android:textColor="#666666"
                android:textSize="9sp"
                android:layout_marginTop="2dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#4A4B50"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp" />

            <!-- Auto-check -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/set_check_automatically"
                    android:textColor="#E0E0E0"
                    android:textSize="11sp"
                    android:paddingEnd="4dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchAutoUpdate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleX="0.85"
                    android:scaleY="0.85" />
            </LinearLayout>

            <!-- Check Updates -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_check_now"
                android:textColor="#E0E0E0"
                android:textSize="11sp"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/btnCheckUpdates"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginBottom="8dp"
                android:backgroundTint="#2196F3"
                android:text="@string/set_check_updates"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:minHeight="0dp"
                android:padding="0dp" />

            <!-- BACKUP & RESTORE section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_section_backup"
                android:textColor="#6B8EFF"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.15"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_backup_subtitle"
                android:textColor="#666666"
                android:textSize="9sp"
                android:layout_marginTop="2dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#4A4B50"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnBackup"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="3dp"
                    android:backgroundTint="#4CAF50"
                    android:text="@string/set_backup"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:minHeight="0dp"
                    android:padding="0dp" />

                <Button
                    android:id="@+id/btnRestore"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:backgroundTint="#FF9800"
                    android:text="@string/set_restore"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:minHeight="0dp"
                    android:padding="0dp" />
            </LinearLayout>

            <!-- ICONS section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_section_icons"
                android:textColor="#6B8EFF"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.15"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btnRefreshIcons"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:backgroundTint="#2196F3"
                android:text="@string/set_refresh_icons"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:minHeight="0dp"
                android:padding="0dp"
                android:layout_marginBottom="8dp" />

            <!-- STATS section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_section_usage"
                android:textColor="#6B8EFF"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.15"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_usage_subtitle"
                android:textColor="#666666"
                android:textSize="9sp"
                android:layout_marginTop="2dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#4A4B50"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp" />

            <!-- Game Stats -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_usage_monitor"
                android:textColor="#E0E0E0"
                android:textSize="11sp"
                android:layout_marginBottom="4dp" />

            <!-- Usage Access -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_grant_monitor_perms"
                android:textColor="#E0E0E0"
                android:textSize="9sp"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/btnUsageAccess"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:backgroundTint="#FF5722"
                android:text="@string/set_grant_permission"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:minHeight="0dp"
                android:padding="0dp" />

            <Button
                android:id="@+id/btnGameStats"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:backgroundTint="#9C27B0"
                android:text="@string/set_view_stats"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:minHeight="0dp"
                android:padding="0dp" />

        </LinearLayout>

        <!-- Column Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#4A4B50" />

        <!-- ============================================ -->
        <!-- COLUMN 4: QUEST & APPS -->
        <!-- ============================================ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:orientation="vertical"
            android:clipToPadding="true">

            <!-- QUEST section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_section_quest_utils"
                android:textColor="#6B8EFF"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.15"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_shell_via_shizuku"
                android:textColor="#666666"
                android:textSize="9sp"
                android:layout_marginTop="2dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#4A4B50"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp" />

            <!-- Old UI -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_classic_ui"
                android:textColor="#E0E0E0"
                android:textSize="11sp"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/btnResetUI"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginBottom="6dp"
                android:backgroundTint="#2196F3"
                android:text="@string/set_back_to_old_ui"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:minHeight="0dp"
                android:padding="0dp" />

            <!-- Stop VrShell -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_vr_shell"
                android:textColor="#E0E0E0"
                android:textSize="11sp"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/btnRestartUI"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginBottom="8dp"
                android:backgroundTint="#FF5722"
                android:text="@string/set_stop_vrshell"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:minHeight="0dp"
                android:padding="0dp" />

            <!-- APPS section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_section_apps"
                android:textColor="#6B8EFF"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.15"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_install_bundled"
                android:textColor="#666666"
                android:textSize="9sp"
                android:layout_marginTop="2dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#4A4B50"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp" />

            <!-- Bundled Apps -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_bundled_apps"
                android:textColor="#E0E0E0"
                android:textSize="11sp"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/btnBundledApps"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginBottom="6dp"
                android:backgroundTint="#9C27B0"
                android:text="@string/set_view_apps"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:minHeight="0dp"
                android:padding="0dp" />

            <!-- Storage Manager -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_storage_manager"
                android:textColor="#E0E0E0"
                android:textSize="11sp"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/btnAppManager"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:backgroundTint="#673AB7"
                android:text="@string/set_manage_storage"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:minHeight="0dp"
                android:padding="0dp" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#4A4B50" />

    <!-- Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A1A1A"
        android:padding="8dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:text="@string/set_close"
            android:textColor="#FFFFFF"
            android:backgroundTint="#333333"
            android:textAllCaps="false"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:tag="theme_ignore"
            android:text="@string/set_credit"
            android:textColor="#9A9BA0"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
