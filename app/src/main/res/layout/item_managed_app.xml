<?xml version="1.0" encoding="utf-8"?>
<!-- Cartao de app no Gerenciador: cartao arredondado com icone arredondado, tamanhos e botao Gerenciar em pilula. -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:tag="theme_ignore"
    app:cardBackgroundColor="@color/orbita_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardUseCompatPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Icone + nome + versao -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/appIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_thumb_rounded"
                android:clipToOutline="true"
                android:contentDescription="@string/app_icon"
                android:scaleType="centerCrop"
                android:tag="theme_ignore" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/appLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:tag="theme_ignore"
                    android:text="App Name"
                    android:textColor="@color/orbita_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/appVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:tag="theme_ignore"
                    android:text="v1.0"
                    android:textColor="@color/orbita_accent"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Pacote -->
        <TextView
            android:id="@+id/appPackage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:tag="theme_ignore"
            android:text="com.example.app"
            android:textColor="@color/orbita_text_muted"
            android:textSize="11sp" />

        <!-- Tamanhos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:tag="theme_ignore"
                android:text="@string/mgr_label_app"
                android:textColor="@color/orbita_text_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtAppSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="theme_ignore"
                android:text="0 B"
                android:textColor="@color/orbita_text"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:tag="theme_ignore"
                android:text="@string/mgr_label_data"
                android:textColor="@color/orbita_text_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtDataSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="theme_ignore"
                android:text="0 B"
                android:textColor="@color/orbita_text"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:tag="theme_ignore"
                android:text="@string/mgr_label_cache"
                android:textColor="@color/orbita_text_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtCacheSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="theme_ignore"
                android:text="0 B"
                android:textColor="@color/orbita_text"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Total em destaque -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtTotalLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:tag="theme_ignore"
                android:text="@string/mgr_label_total"
                android:textColor="@color/orbita_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtTotalValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:tag="theme_ignore"
                android:text="0 B"
                android:textColor="@color/orbita_accent"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Gerenciar -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnManage"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/orbita_bg_pill"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:tag="theme_ignore"
            android:text="@string/mgr_manage"
            android:textAllCaps="false"
            android:textColor="@color/orbita_text"
            android:textSize="13sp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
