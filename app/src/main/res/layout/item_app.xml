<?xml version="1.0" encoding="utf-8"?>
<!-- App na grade: so a miniatura arredondada com o nome embaixo (sem cartao, sem borda).
     O card existe apenas para receber clique e a borda de selecao. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

<com.google.android.material.card.MaterialCardView
    android:id="@+id/cardApp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:layout_margin="1dp"
    android:tag="theme_ignore"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:rippleColor="@android:color/transparent"
    android:foreground="@null"
    android:defaultFocusHighlightEnabled="false"
    app:strokeWidth="0dp"
    app:strokeColor="#4C8DFF">

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/appIcon"
            android:layout_width="160dp"
            android:layout_height="90dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:background="@drawable/bg_thumb_rounded"
            android:clipToOutline="true"
            android:scaleType="centerCrop" />

        <!-- Selo de categoria (so aparece com "Mostrar categorias") -->
        <TextView
            android:id="@+id/categoryBadge"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="C"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/appVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:background="#80000000"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/appName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/appIcon"
            android:layout_marginTop="7dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/playtimeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/appName"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:textColor="#6B8EFF"
            android:textSize="9sp"
            android:visibility="gone" />

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>

</FrameLayout>
