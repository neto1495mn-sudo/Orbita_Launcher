<?xml version="1.0" encoding="utf-8"?>
<!-- Linha da vista Lista: cartao arredondado com miniatura 16:9, nome e tempo a direita. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/orbita_bg_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/playtime_fg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="18dp"
    android:paddingBottom="8dp"
    android:tag="theme_ignore">

    <TextView
        android:id="@+id/txtRank"
        android:layout_width="28dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:tag="theme_ignore"
        android:textColor="@color/orbita_text_muted"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/imgGameCover"
        android:layout_width="64dp"
        android:layout_height="36dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/playtime_bg_thumb"
        android:clipToOutline="true"
        android:contentDescription="@string/play_game_cover"
        android:scaleType="centerCrop"
        android:tag="theme_ignore" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtAppName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:tag="theme_ignore"
            android:textColor="@color/orbita_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/txtPercentage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:maxLines="1"
            android:tag="theme_ignore"
            android:textColor="@color/orbita_text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtPlaytime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="sans-serif-medium"
        android:tag="theme_ignore"
        android:textColor="@color/orbita_accent"
        android:textSize="15sp" />
</LinearLayout>
