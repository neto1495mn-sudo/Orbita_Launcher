<?xml version="1.0" encoding="utf-8"?>
<!-- Estilos da tela de tempo de jogo (mesmo visual cinza/arredondado da tela principal). -->
<resources>

    <!-- Item da barra lateral (periodo / voltar) -->
    <style name="PlaytimeSideItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:background">@drawable/orbita_bg_side_item</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/orbita_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:tag">theme_ignore</item>
    </style>

    <!-- Botao pequeno em pilula do cabecalho -->
    <style name="PlaytimePillButton">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:padding">9dp</item>
        <item name="android:background">@drawable/orbita_bg_pill</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/orbita_text</item>
        <item name="android:tag">theme_ignore</item>
    </style>

    <!-- Cartao de resumo -->
    <style name="PlaytimeSummaryCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/orbita_bg_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:tag">theme_ignore</item>
    </style>

    <style name="PlaytimeSummaryLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/orbita_text_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:tag">theme_ignore</item>
    </style>

    <style name="PlaytimeSummaryValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/orbita_text</item>
        <item name="android:textSize">20sp</item>
        <item name="android:tag">theme_ignore</item>
    </style>
</resources>
